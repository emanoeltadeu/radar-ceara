# ==============================================================
# RADAR LÉO SURICATE · VARIÁVEIS DE AMBIENTE (OPCIONAL)
# ==============================================================
# Copie este arquivo para .env ou defina as variáveis no seu ambiente.
# NUNCA commite o arquivo .env preenchido com suas chaves reais.

# Chave da API do Google AI Studio (modelo gemini-3.5-flash-lite)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Chave da API do YouTube Data API v3 (Google Cloud Console)
# Obtenha em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=sua_chave_do_youtube_aqui

# Token de API do Apify para monitoramento do Instagram (apify/instagram-scraper)
# Obtenha em: https://console.apify.com/account/integrations
APIFY_API_TOKEN=seu_token_apify_aqui

